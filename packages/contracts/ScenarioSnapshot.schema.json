        "id": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Id",
          "type": "string"
        },
        "uld_code": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Uld Code",
          "type": "string"
        },
        "uld_type": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Uld Type",
          "type": "string"
        },
        "contour": {
          "maxLength": 100,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_.:-]+$",
          "title": "Contour",
          "type": "string"
        },
        "origin": {
          "pattern": "^[A-Z]{3}$",
          "title": "Origin",
          "type": "string"
        },
        "destination": {
          "pattern": "^[A-Z]{3}$",
          "title": "Destination",
          "type": "string"
        },
        "actual_mass_kg": {
          "gt": 0,
          "le": "1000000000",
          "title": "Actual Mass Kg",
          "type": "string"
        },
        "actual_volume_m3": {
          "gt": 0,
          "le": "1000000000",
          "title": "Actual Volume M3",
          "type": "string"
        },
        "tare_mass_kg": {
          "ge": 0,
          "le": "1000000000",
          "title": "Tare Mass Kg",
          "type": "string"
        },
        "pieces": {
          "items": {
            "$ref": "#/$defs/PieceAssociation"
          },
          "maxItems": 1000,
          "minItems": 1,
          "title": "Pieces",
          "type": "array"
        },
        "service_class": {
          "enum": [
            "GENERAL",
            "PRIORITY",
            "PHARMA",
            "PERISHABLE",
            "DG"
          ],
          "title": "Service Class",
          "type": "string"
        },
        "service_weight": {
          "gt": 0,
          "le": "1000000000",
          "title": "Service Weight",
          "type": "string"
        },
        "ready_at": {
          "format": "date-time",
          "title": "Ready At",
          "type": "string"
        },
        "commitment_at": {
          "format": "date-time",
          "title": "Commitment At",
          "type": "string"
        },
        "requires_cold_chain": {
          "title": "Requires Cold Chain",
          "type": "boolean"
        },
        "dg_class": {
          "enum": [
            "NONE",
            "DECLARED",
            "FREIGHTER_ONLY"
          ],
          "title": "Dg Class",
          "type": "string"
        },
        "serviceability": {
          "$ref": "#/$defs/Verification"
        },
        "security": {
          "$ref": "#/$defs/Verification"
        },
        "contractual_latest_arrival": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contractual Latest Arrival"
        },
        "previous_path_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Previous Path Id"
        },
        "frozen_path_id": {
          "anyOf": [
            {
              "maxLength": 100,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9_.:-]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frozen Path Id"
        },
        "atomic_whole_uld": {
          "const": true,
          "default": true,
          "title": "Atomic Whole Uld",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "uld_code",
        "uld_type",
        "contour",
        "origin",
        "destination",
        "actual_mass_kg",
        "actual_volume_m3",
        "tare_mass_kg",
        "pieces",
        "service_class",
        "service_weight",
        "ready_at",
        "commitment_at",
        "requires_cold_chain",
        "dg_class",
        "serviceability",
        "security"
