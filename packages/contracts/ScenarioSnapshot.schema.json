        "free_mass_kg": {
          "anyOf": [
            {
              "ge": 0,
              "le": "1000000000",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Free Mass Kg"
        },
        "free_volume_m3": {
          "anyOf": [
            {
              "ge": 0,
              "le": "1000000000",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Free Volume M3"
