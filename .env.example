# Development only. Generate a random value with python3 scripts/configure_local.py.
# Do not use this file as a production credential source.
POSTGRES_PASSWORD=
REDIS_PASSWORD=
APP_ENV=development
ENABLE_DEVELOPMENT_AUTH=true
APP_BASE_URL=http://localhost:3000
API_INTERNAL_URL=http://127.0.0.1:8000
CARGOPULSE_ENV=development
DATABASE_URL=postgresql+psycopg://cargopulse_app@127.0.0.1:55432/cargopulse
REDIS_URL=redis://127.0.0.1:56379/0
OBJECT_STORE_ROOT=.local/objects
ENABLE_EXTERNAL_WRITE=false
ENABLE_LIVE_CONNECTORS=false
ENABLE_PROTECT=false
# Production-only configuration must be injected by your secrets manager:
# OIDC_ISSUER, OIDC_CLIENT_ID, OIDC_CLIENT_SECRET, OIDC_REDIRECT_URI,
# OIDC_REQUIRED_ACR, OBJECT_STORE_BUCKET, OBJECT_STORE_ENDPOINT, AWS_REGION,
# workload identity or scoped S3 credentials. Never commit real values.
