FROM node:24.22.2-trixie-slim@sha256:0820eaa85e07d0490446dd01d14707e17e6108a36988cf374899cd057eb3812d AS build
ENV NEXT_TELEMETRY_DISABLED=1
WORKDIR /app
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
RUN npm ci --ignore-scripts --libc=glibc
COPY apps/web apps/web
COPY packages/contracts packages/contracts
RUN npm run build

FROM node:24.22.2-trixie-slim@sha256:0820eaa85e07d0490446dd01d14707e17e6108a36988cf374899cd057eb3812d AS runtime-build
RUN apt-get update && apt-get upgrade -y \
    && apt-get install -y --no-install-recommends python3 ca-certificates tzdata \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=build --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY infra/assemble_runtime.py /assemble_runtime.py
RUN python3 /assemble_runtime.py node /runtime-root \
    && chroot /runtime-root /usr/local/bin/node --version

FROM scratch
ENV PATH=/usr/local/bin:/usr/bin:/bin HOME=/tmp \
    NODE_ENV=production NEXT_TELEMETRY_DISABLED=1 HOSTNAME=0.0.0.0 PORT=3000 \
    SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt
COPY --from=runtime-build /runtime-root /
WORKDIR /app
USER node
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
