FROM python:3.12.16-slim-trixie@sha256:5e2bdb1b0d542d5039cffb8181c65930093949194a65c365dfb1b0fe13a4fa5b AS build
WORKDIR /app
RUN apt-get update && apt-get upgrade -y && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
COPY requirements.lock ./
RUN python -m pip install --no-cache-dir --require-hashes -r requirements.lock
COPY infra/assemble_runtime.py /assemble_runtime.py
RUN python /assemble_runtime.py python /runtime-root \
    && LD_LIBRARY_PATH=/usr/local/lib chroot /runtime-root /usr/local/bin/python -c \
       "import ssl, asyncio, uuid, highspy, numpy, psycopg; assert uuid.uuid4().version == 4"

FROM scratch
ENV PATH=/usr/local/bin:/usr/bin:/bin LD_LIBRARY_PATH=/usr/local/lib \
    HOME=/tmp SSL_CERT_FILE=/etc/ssl/certs/ca-certificates.crt \
    PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/packages/contracts/python:/app/services/api:/app/services/worker:/app
COPY --from=build /runtime-root /
WORKDIR /app
COPY packages/contracts/python packages/contracts/python
COPY packages/domain_fixtures packages/domain_fixtures
COPY services services
COPY infra/bootstrap.py infra/bootstrap.py
USER 10001:10001
EXPOSE 8000
CMD ["python", "-m", "uvicorn", "cargopulse_api.main:app", "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
