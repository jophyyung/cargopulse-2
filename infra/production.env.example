# Template, not a runnable release. Supply values through the target secret manager.
APP_ENV=production
ENABLE_DEVELOPMENT_AUTH=false
ENABLE_EXTERNAL_WRITE=false
ENABLE_LIVE_CONNECTORS=false
ENABLE_PROTECT=false
APP_BASE_URL=https://REPLACE_WITH_APPROVED_DOMAIN
OIDC_ISSUER=https://REPLACE_WITH_APPROVED_ISSUER
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REQUIRED_ACR=
OIDC_REDIRECT_URI=https://REPLACE_WITH_APPROVED_DOMAIN/api/v1/auth/callback
DATABASE_URL=
REDIS_URL=
OBJECT_STORE_BUCKET=
OBJECT_STORE_ENDPOINT=
AWS_REGION=
OTEL_EXPORTER_OTLP_ENDPOINT=

# Published, scanned, signed image references must include @sha256:... .
API_IMAGE=
WEB_IMAGE=
EDGE_IMAGE=
CARGOPULSE_DOMAIN=
OIDC_TENANT_ID=
# Only inject for the separately approved one-shot migration, never into API/worker:
DATABASE_ADMIN_URL=
