FROM postgres:18.6-alpine3.24@sha256:123b17998ccaf47e53b502e8c6a1e79afd8f579c6f3eec83c563da026f957395
# Existing glibc clusters require logical dump/restore into a fresh volume; see
# docs/evidence/13-postgres-runtime.md before changing a running deployment.
# Run as the database user from first initialization; root-switch tooling is unused.
RUN apk upgrade --no-cache && rm -f /usr/local/bin/gosu /bin/su
USER postgres
