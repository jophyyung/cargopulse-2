APP_ENV=development
ENABLE_DEVELOPMENT_AUTH=true
DATABASE_URL=postgresql+psycopg://cargopulse_app@localhost:55432/cargopulse
REDIS_URL=redis://localhost:56379/0
APP_BASE_URL=http://localhost:3000
OBJECT_STORE_ROOT=.local/objects
AUTO_CREATE_SCHEMA=false
ENABLE_EXTERNAL_WRITE=false
ENABLE_LIVE_CONNECTORS=false
ENABLE_PROTECT=false
# Production requires HTTPS, private bucket, approved OIDC grants and MFA context.
# OIDC_ISSUER=https://approved-idp.example
# OIDC_CLIENT_ID=provisioned-client
# OIDC_CLIENT_SECRET=injected-by-secret-manager
# OIDC_REDIRECT_URI=https://application.example/api/v1/auth/callback
# OIDC_REQUIRED_ACR=approved-mfa-context
# OIDC_TENANT_ID=10000000-0000-4000-8000-000000000001
# OBJECT_STORE_BUCKET=private-synthetic-evidence
# OBJECT_STORE_ENDPOINT=https://private-s3.example
